+// Qualification-only instrumentation for the single-thread dev run.
+void trace_draw(int cell, const char* event, float draw, float outcome) {
+    static FILE* stream = nullptr;
+    if (!stream) {
+        stream = fopen(getenv("VERTEX_FATE_TRACE"), "w");
+        if (!stream) { perror("opening fate trace"); abort(); }
+        fprintf(stream, "time,cell_id,event,draw,outcome\n");
+    }
+    fprintf(stream, "%.9g,%d,%s,%.9g,%.9g\n", Time, cell, event, draw, outcome);
+}
+
+bool trial_draw(int cell, const char* event, double threshold) {
+    float draw = rnd();
+    bool accepted = threshold > draw;
+    trace_draw(cell, event, draw, accepted);
+    return accepted;
+}
