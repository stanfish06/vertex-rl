            (x(-2 + i) - x(-1 + i))*Sqrt(Power(-x(-1 + i) + x(i),2) + \
Power(-y(-1 + i) + y(i),2)),2) + 
          Power(Sqrt(Power(-x(-2 + i) + x(-1 + i),2) + Power(-y(-2 + i) + \
y(-1 + i),2))*
             (y(-1 + i) - y(i)) + (y(-2 + i) - y(-1 + i))*
             Sqrt(Power(-x(-1 + i) + x(i),2) + Power(-y(-1 + i) + \
y(i),2)),2)) + 
       (Ls*(Sqrt(Power(-x(-1 + i) + x(i),2) + Power(-y(-1 + i) + \
y(i),2))*(-y(i) + y(1 + i)) + 
            (-y(-1 + i) + y(i))*Sqrt(Power(-x(i) + x(1 + i),2) + Power(-y(i) \
+ y(1 + i),2))))/
        Sqrt(Power((x(i) - x(1 + i))*Sqrt(Power(-x(-1 + i) + x(i),2) + \
Power(-y(-1 + i) + y(i),2)) + 
            (x(-1 + i) - x(i))*Sqrt(Power(-x(i) + x(1 + i),2) + Power(-y(i) + \
y(1 + i),2)),2) + 
          Power(Sqrt(Power(-x(-1 + i) + x(i),2) + Power(-y(-1 + i) + \
y(i),2))*(y(i) - y(1 + i)) + 
            (y(-1 + i) - y(i))*Sqrt(Power(-x(i) + x(1 + i),2) + Power(-y(i) + \
y(1 + i),2)),2)),2))\
